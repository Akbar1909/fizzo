# Postgres connection string (matches docker-compose.yml's db service).
DATABASE_URL="postgresql://fizzo:fizzo@localhost:5434/fizzo?schema=public"

# Token from @BotFather
TELEGRAM_BOT_TOKEN=""
# Bot username without the leading @, used to build the Telegram Login Widget
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Random string, at least 32 characters. Used to sign the session JWT.
SESSION_SECRET=""

# Comma-separated Telegram numeric ids that get access to /admin
ADMIN_TELEGRAM_IDS=""

# "true" enables the local "Test foydalanuvchi bilan kirish" button.
# Refused automatically when NODE_ENV=production.
DEV_LOGIN="false"

# Google Analytics 4 measurement ID (starts with "G-"). Leave empty to disable tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# OAuth 2.0 Client (Web application) from Google Cloud Console. Leave both
# empty to hide the "Google bilan kirish" button on /kirish.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Host port the app container binds to (docker-compose.yml). Only needed if
# 3000 is already taken by another service on this host.
APP_PORT="3000"
